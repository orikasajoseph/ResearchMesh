SEMANTIC_SCHOLAR_API_KEY=
# Optional authenticated fallback when Semantic Scholar is temporarily unavailable.
OPENALEX_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Literature live resource resolution and per-client proxy inheritance.
# 1 inherits the deployment environment; 0 uses a direct connection with TLS verification.
# Choose according to the deployment network; do not copy personal proxy addresses here.
LITERATURE_SEARCH_PROVIDER=semantic-scholar
LITERATURE_OPENALEX_FALLBACK=1
LITERATURE_RESOLVE_RESOURCES=1
LITERATURE_OPENALEX_TRUST_ENV=1
LITERATURE_RESOURCE_TRUST_ENV=1
LITERATURE_OPENALEX_TIMEOUT=8

LITERATURE_REQUEST_TIMEOUT=30
LITERATURE_RATE_LIMIT_SECONDS=1.1
LITERATURE_MAX_RETRIES=3
LITERATURE_BACKOFF_INITIAL_SECONDS=1
LITERATURE_BACKOFF_MAX_SECONDS=8
LITERATURE_CACHE_TTL_SECONDS=3600
LITERATURE_CACHE_MAX_ENTRIES=256

LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2

DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=4096

# Optional alternative OpenAI-compatible provider settings.
# LLM_PROVIDER=qwen
# LLM_API_KEY=
# LLM_BASE_URL=https://example.invalid/v1
# LLM_MODEL=model-name
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_TOKENS=4096
