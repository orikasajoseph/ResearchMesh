SEMANTIC_SCHOLAR_API_KEY=
# Optional, disabled by default. Never copy real keys into this example file.
# LITERATURE_SEARCH_PROVIDER=semantic-scholar
# LITERATURE_OPENALEX_FALLBACK=0
# OPENALEX_API_KEY=
# LITERATURE_RESOLVE_RESOURCES=0
# LITERATURE_RESOURCE_MAX_PAPERS=3
# LITERATURE_RESOURCE_MAX_REQUESTS=12
# LITERATURE_RESOURCE_TIMEOUT_SECONDS=5
# LITERATURE_OPENALEX_TRUST_ENV=1
# LITERATURE_RESOURCE_TRUST_ENV=1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

LITERATURE_REQUEST_TIMEOUT=30
LITERATURE_RATE_LIMIT_SECONDS=1.1
LITERATURE_MAX_RETRIES=3
LITERATURE_BACKOFF_INITIAL_SECONDS=1
LITERATURE_BACKOFF_MAX_SECONDS=8
LITERATURE_CACHE_TTL_SECONDS=3600
LITERATURE_CACHE_MAX_ENTRIES=256

LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2

DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=4096

# Optional alternative OpenAI-compatible provider settings.
# LLM_PROVIDER=qwen
# LLM_API_KEY=
# LLM_BASE_URL=https://example.invalid/v1
# LLM_MODEL=model-name
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_TOKENS=4096

# Formal analysis Group adapters (never start without --serve).
# RM_READER_AIC=<approved Reader AIC>
# RM_REPOSITORY_AIC=<approved Repository AIC>
# RM_ALLOWED_LEADER_AIC=<approved Leader AIC>
# RM_READER_PYTHON=<isolated Reader Python executable>
# RM_READER_WRAPPER_ROOT=<repo>/agents/paper_reader
# RM_READER_RUNTIME_HOME=<existing cache root containing huggingface>
# RM_REPOSITORY_PYTHON=<isolated Python 3.12 with pinned CodeWiki>
# RM_REPOSITORY_WRAPPER_ROOT=<repo>/agents/repository
