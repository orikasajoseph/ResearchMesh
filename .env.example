# 可共享的模板；复制为 .env 后只在本机填写 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=4096

# 新 run_planner.py / live_api.py 默认复用上面的 DeepSeek 配置。
# 只有切换其他兼容提供商时才填写这一组；必须使用该提供商自己的 Key。
# LLM_PROVIDER=qwen
# LLM_BASE_URL=填写该提供商的 HTTPS OpenAI-compatible API 地址
# LLM_MODEL=填写该提供商的模型名
# LLM_API_KEY=只在本机 .env 填写，禁止提交共享
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_TOKENS=4096
